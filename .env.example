# ASFTool Configuration
# Copy this file to .env and fill in your values.
#
# The variable names below are the ones the code actually reads. Earlier
# versions of this file used an `ASFTOOL_` prefix that was never applied.
#
# You can also run `asftool init` to generate a working .env with a
# freshly generated ENCRYPTION_KEY.

# Application Settings
APP_NAME=asftool
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Salesforce Analytics REST API Settings
# Force UTF-8 encoding for CLI output (emoji support for Analytics REST API response data)
PYTHONIOENCODING=utf-8
# Default is v68.0 (Winter '27). Override with SF_API_VERSION.
# Format: v<major>.<minor>, e.g. v60.0, v65.0, v68.0
SF_API_VERSION=v68.0
SF_DEFAULT_DOMAIN=login.salesforce.com

# Encryption Settings
# Required: this key encrypts the tokens stored in the OS keyring.
# Generate one with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (or just run `asftool init`)
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# JWT Settings (for internal token signing, not for Salesforce auth)
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Field Impact Analysis Settings
# Maximum number of assets scanned in parallel. Raise carefully: the
# Analytics REST API rate-limits aggressively.
FIELD_IMPACT_MAX_CONCURRENT_SCANS=10
FIELD_IMPACT_DEFAULT_FUZZY_THRESHOLD=85
FIELD_IMPACT_DEFAULT_MATCH_MODE=both
