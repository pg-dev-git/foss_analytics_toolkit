# ASFTool Configuration
# Copy this file to .env and fill in your values
# All variables use the ASFTOOL_ prefix (or no prefix for shared ones)

# Application Settings
ASFTOOL_APP_NAME=asftool
ASFTOOL_APP_VERSION=0.1.0
ASFTOOL_DEBUG=false
ASFTOOL_LOG_LEVEL=INFO

# Salesforce API Settings
ASFTOOL_SF_API_VERSION=v60.0
ASFTOOL_SF_DEFAULT_DOMAIN=login.salesforce.com

# Encryption Settings
# Generate a secure key: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# JWT Settings (for internal token signing, not for Salesforce auth)
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Connected App Credentials (optional — for JWT Bearer flow)
# ASFTOOL_SF_CONNECTED_APP_CLIENT_ID=your-consumer-key
# ASFTOOL_SF_CONNECTED_APP_CLIENT_SECRET=your-consumer-secret
# ASFTOOL_SF_CONNECTED_APP_USERNAME=your-salesforce-username

# Web OAuth Settings (optional — for PKCE flow)
# ASFTOOL_SF_WEB_OAUTH_CLIENT_ID=your-consumer-key
# ASFTOOL_SF_WEB_OAUTH_CLIENT_SECRET=your-consumer-secret
# ASFTOOL_SF_WEB_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Device Flow Settings (optional — for headless/terminal login)
# ASFTOOL_SF_DEVICE_FLOW_CLIENT_ID=your-consumer-key
